# Copy to .env.maplite (git-ignored) or run scripts/setup-mikrotik.sh maplite. Keep it local.
# Required:
MTUNIFI_INFORM_URL=http://192.0.2.20:8080/inform
MTUNIFI_MAPLITE_HOST=192.0.2.2
MTUNIFI_MAPLITE_USER=unifi-reader
# Optional (defaults in brackets):
# IPv4 shown in UniFi [RouterOS address]
MTUNIFI_MAPLITE_IP=
# Device MAC [auto = RouterOS ether1 MAC, read once at first start]
MTUNIFI_MAPLITE_MAC=
# Port map [/scenarios/routeros-maplite.json]; "auto" maps ports in order
MTUNIFI_MAPLITE_MAP=
# Firmware version to report, to hide the update badge [profile version]
MTUNIFI_MAPLITE_VERSION=
# Neighbor MAC rewrites "seen=device,..." [none]
MTUNIFI_MAPLITE_NEIGHBOR_ALIASES=
MTUNIFI_MAPLITE_POLL_INTERVAL=30
# Docker volume holding the identity [unifi-sim_maplite-state]
MTUNIFI_MAPLITE_STATE_VOLUME=
