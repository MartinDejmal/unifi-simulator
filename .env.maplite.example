# Copy to .env.maplite (git-ignored) and fill in your own values. Keep it local.
MTUNIFI_INFORM_URL=http://192.0.2.20:8080/inform
# IPv4 that UniFi shows for the device, and the RouterOS API address.
MTUNIFI_MAPLITE_IP=192.0.2.2
MTUNIFI_MAPLITE_HOST=192.0.2.2
MTUNIFI_MAPLITE_USER=unifi-reader
# RouterOS ether1 MAC. Example value only.
MTUNIFI_MAPLITE_MAC=00:00:5e:00:53:02
# Optional: controller's current US8 firmware, neighbor MAC rewrites "real=reported,...".
MTUNIFI_MAPLITE_VERSION=
MTUNIFI_MAPLITE_NEIGHBOR_ALIASES=
MTUNIFI_MAPLITE_POLL_INTERVAL=30
# Optional: name of an existing state volume to keep its identity.
MTUNIFI_MAPLITE_STATE_VOLUME=unifi-sim_maplite-state
