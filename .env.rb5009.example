# Copy to .env.rb5009 (git-ignored) or run scripts/setup-mikrotik.sh rb5009. Keep it local.
# Required:
MTUNIFI_INFORM_URL=http://192.0.2.20:8080/inform
MTUNIFI_RB5009_HOST=192.0.2.1
MTUNIFI_RB5009_USER=unifi-reader
# Optional (defaults in brackets):
# IPv4 shown in UniFi [RouterOS address]
MTUNIFI_RB5009_IP=
# Device MAC [auto = RouterOS ether1 MAC, read once at first start]
MTUNIFI_RB5009_MAC=
# Port map [/scenarios/routeros-rb5009-switch.json]; "auto" maps ports in order
MTUNIFI_RB5009_MAP=
# Total PoE-out budget in W from the datasheet [not reported]
MTUNIFI_RB5009_POE_BUDGET_W=
# Neighbor MAC rewrites "seen=device,..." [none]
MTUNIFI_RB5009_NEIGHBOR_ALIASES=
# Docker volume holding the identity [unifi-sim_rb5009-switch-state]
MTUNIFI_RB5009_STATE_VOLUME=
# Gateway variant (compose.rb5009-gateway.yml) only:
MTUNIFI_RB5009_WAN1=ether1
MTUNIFI_RB5009_WAN2=ether5
