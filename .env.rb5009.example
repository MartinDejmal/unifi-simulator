# Copy to .env.rb5009 (git-ignored) and fill in your own values. Keep it local.
MTUNIFI_INFORM_URL=http://192.0.2.20:8080/inform
# IPv4 that UniFi shows for the device, and the RouterOS API address.
MTUNIFI_RB5009_IP=192.0.2.1
MTUNIFI_RB5009_HOST=192.0.2.1
MTUNIFI_RB5009_USER=unifi-reader
# RouterOS ether1 MAC (the LLDP chassis ID other devices see). Example value only.
MTUNIFI_RB5009_MAC=00:00:5e:00:53:01
# Optional: total PoE-out budget in W, neighbor MAC rewrites "real=reported,...".
MTUNIFI_RB5009_POE_BUDGET_W=
MTUNIFI_RB5009_NEIGHBOR_ALIASES=
# Optional: name of an existing state volume to keep its identity.
MTUNIFI_RB5009_STATE_VOLUME=unifi-sim_rb5009-switch-state
# Gateway variant (compose.rb5009-gateway.yml) only:
MTUNIFI_RB5009_WAN1=ether1
MTUNIFI_RB5009_WAN2=ether5
